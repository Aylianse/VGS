# Database (Neon Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Admin auth (required in production)
JWT_SECRET="generate-a-long-random-string"

# Admin seed credentials (used by `npm run db:seed` only)
ADMIN_EMAIL="admin@vitaglowproducts.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://vitaglowproducts.com"

# Contact / site info (optional — defaults exist in src/lib/site.ts)
# NEXT_PUBLIC_EMAIL="info@vitaglowproducts.com"
# NEXT_PUBLIC_PHONE="+971562717889"
# NEXT_PUBLIC_PHONE_DISPLAY="+971 56 271 7889"
# NEXT_PUBLIC_WHATSAPP="971562717889"

# Contact form via Web3Forms (optional)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"
